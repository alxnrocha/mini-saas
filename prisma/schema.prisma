datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClientStatus {
  active
  onboarding
  paused
  churned
}

enum ProjectStatus {
  planning
  in_progress
  on_hold
  completed
}

enum InvoiceStatus {
  paid
  unpaid
  overdue
  cancelled
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  companyName  String   @default("Acme Digital Co.")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clients      Client[]

  @@map("users")
}

model Client {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  domain       String
  contactName  String
  contactEmail String
  phone        String?
  status       ClientStatus @default(active)
  mrrAmount    Decimal      @default(0.00) @db.Decimal(10, 2)
  totalBilled  Decimal      @default(0.00) @db.Decimal(10, 2)
  unpaidAmount Decimal      @default(0.00) @db.Decimal(10, 2)
  lastActivity DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  invoices     Invoice[]

  @@index([userId])
  @@index([status])
  @@map("clients")
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  budget    Decimal       @db.Decimal(10, 2)
  status    ProjectStatus @default(in_progress)
  deadline  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceCode String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(unpaid)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}
